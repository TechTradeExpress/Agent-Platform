{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Backend-independent static diagnostic evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope",
    "source_sha",
    "source_sha_origin",
    "ownership_scope",
    "catalog_sha256",
    "bubblewrap_version",
    "checks",
    "evidence",
    "result"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "source_sha_origin": {
      "const": "operator_assertion"
    },
    "ownership_scope": {
      "const": "current_user_namespace_only"
    },
    "catalog_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "bubblewrap_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "checks": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z_]{1,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "outcome",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "outcome": {
            "$ref": "#/$defs/outcome"
          },
          "reason": {
            "type": "string",
            "pattern": "^[a-z_]{1,64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offline_ci",
        "real_kernel",
        "authenticated_execution",
        "credential_isolation",
        "live_inference"
      ],
      "properties": {
        "offline_ci": {
          "$ref": "#/$defs/outcome"
        },
        "real_kernel": {
          "$ref": "#/$defs/outcome"
        },
        "authenticated_execution": {
          "$ref": "#/$defs/outcome"
        },
        "credential_isolation": {
          "$ref": "#/$defs/outcome"
        },
        "live_inference": {
          "$ref": "#/$defs/outcome"
        }
      }
    },
    "result": {
      "const": "E2E_BLOCKED"
    },
    "host_status": {
      "enum": [
        "host_hints_pass",
        "host_hints_blocked"
      ]
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2048
    },
    "bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 536870912
    },
    "visible_root_owned": {
      "type": "boolean"
    },
    "scope": {
      "const": "static_diagnostics_only"
    }
  },
  "$defs": {
    "outcome": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN"
      ]
    }
  }
}

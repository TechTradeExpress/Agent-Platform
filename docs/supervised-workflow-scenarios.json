{
  "schema": "AP-SUPERVISED-SCENARIOS/1",
  "_comment": "Fabricated, offline, non-authorizing scenarios. Facts are booleans/enums, never paths or secrets. The reference evaluator lives in the test file; this fixture is documentation of expected outcomes only.",
  "defaults": {
    "mode": "C",
    "harness_selected": "claude_code",
    "harness_running": "claude_code",
    "issue_assigned": true,
    "binary_expected": true,
    "instruction_conflict": false,
    "base_ref": "published_upstream_head",
    "upstream_head_unchanged": true,
    "upstream_ci": "success",
    "branch": "absent",
    "tracked_changes": false,
    "untracked_files": false,
    "ignored_files": false,
    "publish_authorized": false,
    "publish_authority_source": "none",
    "publisher_available": false,
    "push_nonff": false,
    "pr_base": "upstream_branch",
    "action": "local_commit",
    "user_level_claude_md": false,
    "agents_load_confirmed": false,
    "issue_ref": "refs"
  },
  "scenarios": [
    {
      "id": "W-01",
      "title": "Stacked task from exact published upstream HEAD, local commit",
      "facts": {},
      "expected": {
        "decision": "ALLOW",
        "code": "OK"
      }
    },
    {
      "id": "W-02",
      "title": "Local-only task (B) from published upstream HEAD, local commit",
      "facts": {
        "mode": "B"
      },
      "expected": {
        "decision": "ALLOW",
        "code": "OK"
      }
    },
    {
      "id": "W-03",
      "title": "Standard task (A) from verified origin/main, local commit",
      "facts": {
        "mode": "A",
        "base_ref": "verified_origin_main"
      },
      "expected": {
        "decision": "ALLOW",
        "code": "OK"
      }
    },
    {
      "id": "W-04",
      "title": "Stacked task based on main instead of upstream HEAD",
      "facts": {
        "base_ref": "verified_origin_main"
      },
      "expected": {
        "decision": "STOP",
        "code": "BASE_INVALID"
      }
    },
    {
      "id": "W-05",
      "title": "Stacked task based on a local unpublished upstream commit",
      "facts": {
        "base_ref": "local_unpublished_commit"
      },
      "expected": {
        "decision": "STOP",
        "code": "BASE_INVALID"
      }
    },
    {
      "id": "W-06",
      "title": "Standard task on a stale origin/main",
      "facts": {
        "mode": "A",
        "base_ref": "stale_origin_main"
      },
      "expected": {
        "decision": "STOP",
        "code": "BASE_INVALID"
      }
    },
    {
      "id": "W-07",
      "title": "Standard task on local main without fresh verification",
      "facts": {
        "mode": "A",
        "base_ref": "local_main"
      },
      "expected": {
        "decision": "STOP",
        "code": "BASE_INVALID"
      }
    },
    {
      "id": "W-08",
      "title": "Base cannot be verified",
      "facts": {
        "base_ref": "unverified"
      },
      "expected": {
        "decision": "STOP",
        "code": "BASE_INVALID"
      }
    },
    {
      "id": "W-09",
      "title": "Published upstream HEAD changed after assignment",
      "facts": {
        "upstream_head_unchanged": false
      },
      "expected": {
        "decision": "STOP",
        "code": "UPSTREAM_HEAD_CHANGED"
      }
    },
    {
      "id": "W-10",
      "title": "Upstream checks no longer green",
      "facts": {
        "upstream_ci": "failure"
      },
      "expected": {
        "decision": "STOP",
        "code": "UPSTREAM_CI_NOT_GREEN"
      }
    },
    {
      "id": "W-11",
      "title": "Target branch exists but is unrelated",
      "facts": {
        "branch": "unrelated"
      },
      "expected": {
        "decision": "STOP",
        "code": "BRANCH_CONFLICT"
      }
    },
    {
      "id": "W-12",
      "title": "Target branch is checked out in another worktree",
      "facts": {
        "branch": "occupied_elsewhere"
      },
      "expected": {
        "decision": "STOP",
        "code": "BRANCH_CONFLICT"
      }
    },
    {
      "id": "W-13",
      "title": "Remote branch has unaccounted commits",
      "facts": {
        "branch": "remote_unaccounted"
      },
      "expected": {
        "decision": "STOP",
        "code": "BRANCH_CONFLICT"
      }
    },
    {
      "id": "W-14",
      "title": "Target worktree has tracked changes",
      "facts": {
        "tracked_changes": true
      },
      "expected": {
        "decision": "STOP",
        "code": "WORKTREE_NOT_CLEAN"
      }
    },
    {
      "id": "W-15",
      "title": "Target worktree has untracked files",
      "facts": {
        "untracked_files": true
      },
      "expected": {
        "decision": "STOP",
        "code": "WORKTREE_NOT_CLEAN"
      }
    },
    {
      "id": "W-16",
      "title": "Target worktree has ignored data that would be lost",
      "facts": {
        "ignored_files": true
      },
      "expected": {
        "decision": "STOP",
        "code": "WORKTREE_NOT_CLEAN"
      }
    },
    {
      "id": "W-17",
      "title": "Claude Code with CLAUDE.md in the project path",
      "facts": {
        "instruction_conflict": true
      },
      "expected": {
        "decision": "STOP",
        "code": "INSTRUCTION_CONFLICT"
      }
    },
    {
      "id": "W-18",
      "title": "Claude Code with CLAUDE.local.md in an ancestor",
      "facts": {
        "instruction_conflict": true
      },
      "expected": {
        "decision": "STOP",
        "code": "INSTRUCTION_CONFLICT"
      }
    },
    {
      "id": "W-19",
      "title": "No harness selected for the worker",
      "facts": {
        "harness_selected": null

[Unit]
Description=Worker01 Issue 169 recovery (signer)

[Service]
Type=oneshot
User=ap-publisher-signer
Group=ap-publisher-signer
SupplementaryGroups=
UMask=0077
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN GIT_ASKPASS SSH_AUTH_SOCK SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR OPENSSL_CONF OPENSSL_MODULES HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/libexec/ap-worker-publisher-recovery-signer
LoadCredential=handoff:/run/ap-publisher-recovery-169-grants/signer.json
LoadCredential=approval-pin:/etc/ap-publisher-recovery-169/approval-pin
ReadWritePaths=/var/lib/ap-publisher-recovery-169-signer/journal
LoadCredential=app-key:/etc/ap-publisher-keys/worker.pem
AppArmorProfile=ap-worker-publisher-recovery-signer
RuntimeDirectory=ap-publisher-recovery-169-signer
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
LimitNOFILE=32
TasksMax=4
MemoryMax=128M
CPUQuota=100%
TimeoutStartSec=10
TimeoutStopSec=5
KillMode=control-group
Restart=no
StandardOutput=journal
StandardError=null
SocketBindDeny=any
IPAddressDeny=any
ReadOnlyPaths=/run/ap-publisher-recovery-169-artifact/candidate.json
ReadOnlyPaths=-/etc/ap-publisher-recovery-169 /usr/lib/ap-worker-publisher
InaccessiblePaths=-/etc/ap-publisher -/etc/ap-publisher-keys -/var/lib/ap-publisher -/var/lib/ap-publisher-signer -/var/lib/ap-publisher-recovery -/run/ap-publisher-signer -/var/lib/ap-publisher-recovery-169-publisher -/run/ap-publisher-recovery-169-publisher

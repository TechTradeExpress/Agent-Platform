#include <tunables/global>
profile ap-worker-publisher-recovery-signer /usr/libexec/ap-worker-publisher-recovery-signer flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/python>
  /usr/libexec/ap-worker-publisher-recovery-signer r,
  /usr/bin/python3* ixr,
  /usr/ r,
  /usr/lib/ r,
  /usr/lib/ap-worker-publisher/ r,
  /usr/lib/ap-worker-publisher/agent_platform/ r,
  /usr/lib/ap-worker-publisher/** r,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  / r,
  /run/ r,
  /run/credentials/ r,
  /run/ap-publisher-recovery-169-live r,
  /run/ap-publisher-recovery-169-artifact/ r,
  /run/ap-publisher-recovery-169-artifact/candidate.json r,
  /run/credentials/ap-worker-publisher-recovery-signer.service/ r,
  /run/credentials/ap-worker-publisher-recovery-signer.service/{handoff,approval-pin} r,
  /var/ r,
  /var/lib/ r,
  /var/lib/ap-publisher-recovery-169-signer/ r,
  /var/lib/ap-publisher-recovery-169-signer/journal rwk,
  /proc/[0-9]*/{status,attr/current} r,
  /etc/{passwd,group,nsswitch.conf} r,
  deny /run/ap-publisher-recovery-169-grants/{,**} rwklmx,
  deny /run/credentials/ap-worker-publisher-recovery.service/{,**} rwklmx,
  deny /var/lib/ap-publisher-recovery-169-publisher/{,**} rwklmx,
  deny /run/ap-publisher-recovery-169-publisher/{,**} rwklmx,
  /run/credentials/ap-worker-publisher-recovery-signer.service/app-key r,
  /run/ap-publisher-recovery-169-signer/ r,
  /run/ap-publisher-recovery-169-signer/{app-jwt,result.json} rw,
  deny network,
  deny ptrace,
  signal (receive) peer=unconfined,
  deny signal (send),
  deny /etc/ap-publisher{,-keys}/{,**} rwklmx,
  deny /var/lib/ap-publisher{,-signer,-recovery}/{,**} rwklmx,
  deny /run/ap-publisher-signer/{,**} rwklmx,
  deny /etc/ap-publisher-recovery-169/{,**} rwklmx,
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /proc/*/{mem,environ,fd/**,map_files/**} rwklmx,
}

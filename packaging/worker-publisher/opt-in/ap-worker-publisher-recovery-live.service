[Unit]
Description=Worker01 Issue 169 recovery (signed live publisher)

[Service]
Type=oneshot
User=ap-publisher
Group=ap-publisher
SupplementaryGroups=
UMask=0077
UnsetEnvironment=GH_TOKEN GITHUB_TOKEN GIT_ASKPASS SSH_AUTH_SOCK SSLKEYLOGFILE SSL_CERT_FILE SSL_CERT_DIR OPENSSL_CONF OPENSSL_MODULES HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/libexec/ap-worker-publisher-recovery-live
LoadCredential=handoff:/run/ap-publisher-recovery-169-grants/publisher.json
LoadCredential=approval-pin:/etc/ap-publisher-recovery-169/approval-pin
LoadCredential=observer-pin:/etc/ap-publisher/observer-trust/key-pin
LoadCredential=boot-id:/proc/sys/kernel/random/boot_id
ReadWritePaths=/var/lib/ap-publisher-recovery-169-publisher/journal
AppArmorProfile=ap-worker-publisher-recovery-live
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET
SocketBindDeny=any
IPAddressDeny=any
# Operator adds one IPAddressAllow=approved IPv4/32 in this fragment.
LimitCORE=0
LimitNOFILE=64
TasksMax=8
MemoryMax=256M
CPUQuota=100%
TimeoutStartSec=310
TimeoutStopSec=5
KillMode=control-group
Restart=no
SuccessExitStatus=2
StandardOutput=journal
StandardError=null
PrivateNetwork=no
NetworkNamespacePath=/run/netns/ap-worker-publisher-recovery-live
RuntimeDirectory=ap-publisher-recovery-169-publisher
RuntimeDirectoryMode=0700
ReadOnlyPaths=/run/ap-publisher-recovery-169-artifact/candidate.json
ReadOnlyPaths=-/etc/ap-publisher-recovery-169 /usr/lib/ap-worker-publisher
InaccessiblePaths=-/etc/ap-publisher -/etc/ap-publisher-keys -/var/lib/ap-publisher -/var/lib/ap-publisher-signer -/var/lib/ap-publisher-recovery -/run/ap-publisher-signer -/var/lib/ap-publisher-recovery-169-signer -/run/ap-publisher-recovery-169-signer

#include <tunables/global>
profile ap-worker-publisher-signer /usr/libexec/ap-worker-publisher-signer flags=(attach_disconnected) {
  #include <abstractions/base>
  #include <abstractions/python>
  # PKG-14: descriptor walks; r permits listing.
  / r,
  /etc/ r,
  /etc/ap-publisher/ r,
  /run/ r,
  /run/credentials/ r,
  /run/credentials/ap-worker-publisher-signer.service/ r,
  /usr/ r,
  /usr/lib/ r,
  /usr/lib/ap-worker-publisher/ r,
  /usr/lib/ap-worker-publisher/agent_platform/ r,
  /var/ r,
  /var/lib/ r,
  /var/lib/ap-publisher-signer/ r,
  deny /etc/ap-publisher/{candidate,homelab-candidate}.json rwklmx,
  deny /etc/ap-publisher-keys/ rwklmx,
  deny /etc/ap-publisher-keys/** rwklmx,
  deny /var/lib/ap-publisher/ rwklmx,
  deny /run/credentials/ap-worker-publisher.service/ rwklmx,
  deny /run/credentials/ap-worker-publisher.service/** rwklmx,
  /usr/libexec/ap-worker-publisher-signer r,
  /usr/bin/python3* ixr,
  /usr/lib/ap-worker-publisher/** r,
  /usr/lib/** mr,
  /etc/ld.so.cache r,
  /etc/{passwd,group,nsswitch.conf} r,
  /etc/ap-publisher/{job,receipts}.json r,
  /var/lib/ap-publisher-signer/journal rwk,
  /run/ap-publisher-signer/ r,
  /run/ap-publisher-signer/app-jwt rw,
  /run/credentials/ap-worker-publisher-signer.service/app-key r,
  /proc/[0-9]*/{status,attr/current} r,
  deny network,
  deny ptrace,
  signal (receive) peer=unconfined,
  deny signal (send),
  deny /home/** rwklmx,
  deny /root/** rwklmx,
  deny /var/lib/ap-publisher/** rwklmx,
  deny /proc/*/{mem,environ,fd/**,map_files/**} rwklmx,
}

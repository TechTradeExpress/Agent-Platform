#!/bin/sh
set -eu
# Fixed data-only checks before dpkg may replace a new P1 leaf. No Python,
# provisioning, profile load, account command, network or service operation.
fail() { echo worker_package_path_conflict >&2; exit 1; }
for dir in /usr /usr/lib /usr/libexec /usr/lib/systemd /usr/lib/systemd/system /etc /etc/apparmor.d /usr/lib/ap-worker-publisher /usr/lib/ap-worker-publisher/agent_platform /usr/lib/agent-platform-worker /usr/lib/agent-platform-worker/provisioning /usr/lib/agent-platform-worker/provisioning/evidence; do
    test ! -L "$dir" || fail
    if test -e "$dir"; then
        test -d "$dir" || fail
        test "$(stat -c '%u:%g:%a' "$dir")" = 0:0:755 || fail
    fi
done
for unit in ap-worker-publisher ap-worker-publisher-signer; do
    for path in "/etc/systemd/system/$unit.service" "/etc/systemd/system/$unit.service.d" "/run/systemd/system/$unit.service" "/run/systemd/system/$unit.service.d"; do
        if test -e "$path" || test -L "$path"; then fail; fi
    done
    for root in /etc/systemd/system /run/systemd/system; do
        if test -d "$root"; then
            found=$(timeout 5 find "$root" -maxdepth 3 -type l \( -name "$unit.service" -o -lname "*/$unit.service" -o -lname "$unit.service" \) -print) || fail
            test -z "$found" || fail
        fi
    done
done
# Read-only manager observation; never start/stop/reload/enable anything.
if test -d /run/systemd/system; then
    read_state() {
        timeout 5 /usr/bin/systemctl show --all --property=ActiveState,SubState,LoadState,MainPID,ControlPID,Job,Transient,Type,Restart,ControlGroup "$1.service"
    }
    for unit in ap-worker-publisher ap-worker-publisher-signer; do
        first=$(read_state "$unit") || fail
        group="/system.slice/$unit.service"
        # A populated service cgroup blocks even if systemd reports zero PIDs.
        if test -e "/sys/fs/cgroup$group" || test -L "/sys/fs/cgroup$group"; then
            test -d "/sys/fs/cgroup$group" && test ! -L "/sys/fs/cgroup$group" || fail
            test -r "/sys/fs/cgroup$group/cgroup.events" || fail
            populated=$(timeout 5 awk '$1 == "populated" {print $2}' "/sys/fs/cgroup$group/cgroup.events") || fail
            test "$populated" = 0 || fail
        fi
        second=$(read_state "$unit") || fail
        test "$first" = "$second" || fail
        # Require a complete, exact property set. Reordering is harmless;
        # duplicate, omitted or unexpected properties are ambiguous.
        facts=$(printf '%s\n' "$first" | LC_ALL=C sort) || fail
        # Only the default, known cgroup location or no manager cgroup is safe.
        case "$facts" in
            *"
ControlGroup=$group
"*) facts=$(printf '%s\n' "$facts" | sed "s|^ControlGroup=$group\$|ControlGroup=|") || fail ;;
        esac
        inactive='ActiveState=inactive
ControlGroup=
ControlPID=0
Job=
LoadState=loaded
MainPID=0
Restart=no
SubState=dead
Transient=no
Type=oneshot'
        failed='ActiveState=failed
ControlGroup=
ControlPID=0
Job=
LoadState=loaded
MainPID=0
Restart=no
SubState=failed
Transient=no
Type=oneshot'
        missing='ActiveState=inactive
ControlGroup=
ControlPID=0
Job=
LoadState=not-found
MainPID=0
Restart=no
SubState=dead
Transient=no
Type=simple'
        if test "$facts" = "$inactive"; then continue; fi
        if test "$unit" = ap-worker-publisher && test "$facts" = "$failed"; then
            continue
        fi
        # An absent service is expected only when installing for the first time.
        if test "${1-}" = install && test -z "${2-}" && test "$facts" = "$missing"; then
            continue
        fi
        fail
    done
fi
for dir in /usr/lib/ap-worker-publisher /usr/lib/agent-platform-worker/provisioning; do
    if test -e "$dir"; then
        owner=$(dpkg-query -S "$dir" 2>/dev/null) || fail
        test "$owner" = "agent-platform-worker: $dir" || fail
        timeout 10 find "$dir" -maxdepth 8 -exec /bin/sh -c '
            for entry do
                case "$entry" in @CLOSED_ROOT_ENTRIES@) ;; *) exit 1 ;; esac
            done
        ' sh {} + || fail
    fi
done
while IFS= read -r path; do
    if test -e "$path" || test -L "$path"; then
        test ! -L "$path" && test -f "$path" || fail
        test "$(stat -c '%u:%g:%h' "$path")" = 0:0:1 || fail
        case "$(stat -c '%a' "$path")" in 600|640|644|700|750|755) ;; *) fail ;; esac
        owner=$(dpkg-query -S "$path" 2>/dev/null) || fail
        test "$owner" = "agent-platform-worker: $path" || fail
    fi
done <<'AP_OWNED_PATHS'
@OWNED_PATHS@
AP_OWNED_PATHS
exit 0
